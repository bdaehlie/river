// Path control configuration
//
// This file exercises the path control grammar, so that `--validate-configs`
// covers it in CI. Every filter kind appears at least once, along with the
// settings that control how a rejected request is answered.

system {
    threads-per-service 8
}

services {
    // A service that rejects traffic, using the default answer for a blocked
    // range.
    Defaults {
        listeners {
            "0.0.0.0:8080"
        }
        connectors {
            "127.0.0.1:9000"
        }
        path-control {
            request-filters {
                // No 'status', so a matching address gets 403 - a blocked
                // source is forbidden, not unauthenticated.
                filter kind="block-cidr-range" \
                    addrs="192.168.0.0/16, 10.0.0.0/8, 2001:0db8::0/32, 127.0.0.2"
            }
        }
    }

    // The same filter, answering the way this operator wants it to.
    ChosenRejection {
        listeners {
            "0.0.0.0:8081"
        }
        connectors {
            "127.0.0.1:9000"
        }
        path-control {
            request-filters {
                // Answering 404 rather than 403 tells a scanner nothing about
                // whether the address range is what got it turned away.
                filter kind="block-cidr-range" addrs="10.0.0.0/8" \
                    status=404 body="Not Found\n"
            }
        }
    }

    // Every header modifier, on both sides of the exchange.
    Headers {
        listeners {
            "0.0.0.0:8082"
        }
        connectors {
            "127.0.0.1:9000"
        }
        path-control {
            upstream-request {
                filter kind="remove-header-key-regex" pattern=".*(secret|SECRET).*"
                filter kind="upsert-header" key="x-proxy-friend" value="river"
            }
            upstream-response {
                filter kind="remove-header-key-regex" pattern=".*ETag.*"
                filter kind="upsert-header" key="x-with-love-from" value="river"
            }
            // Unlike 'upstream-response', this also runs for a response that
            // was served from cache rather than fetched upstream.
            response-filters {
                filter kind="upsert-header" key="x-served-by" value="river"
            }
        }
    }

    // Bounds on how much body River is willing to move in either direction.
    Bodies {
        listeners {
            "0.0.0.0:8083"
        }
        connectors {
            "127.0.0.1:9000"
        }
        path-control {
            request-body {
                // 1 MiB. A request declaring more than this in Content-Length
                // is turned away before its body is read at all; one that
                // declares nothing is counted as it arrives.
                filter kind="max-size" max-bytes=1048576
            }
            response-body {
                // 10 MiB. Defaults to answering 502 rather than 413, because
                // an oversize response is the upstream server misbehaving.
                filter kind="max-size" max-bytes=10485760
            }
        }
    }

    // Routing: different paths, different sets of servers, each balanced and
    // health checked in its own way.
    Routed {
        listeners {
            "0.0.0.0:8084"
        }
        routes {
            // How a request that matches nothing is answered.
            no-route status=404 body="No route for that path\n"

            // Exact matches are tried before any prefix, so this wins over
            // the "/" route below even though that one also matches.
            route "/healthz" match="exact" {
                connectors {
                    "127.0.0.1:9001"
                }
            }

            // The longer prefix wins over the shorter one, whatever order
            // they appear in here.
            route "/api/v2" {
                connectors {
                    load-balance {
                        selection "Ketama" key="UriPath"
                        health-check "HTTP" host="api.example.com" path="/healthz"
                    }
                    "127.0.0.1:9002"
                    "127.0.0.1:9003"
                }
            }

            route "/api" {
                connectors {
                    load-balance {
                        selection "RoundRobin"
                    }
                    "127.0.0.1:9004"
                }
            }

            // Only these methods reach this route; a GET /upload falls
            // through to "/" instead.
            route "/upload" methods="POST,PUT" {
                connectors {
                    "127.0.0.1:9005"
                }
            }

            // A regular expression, tried after every prefix.
            route "^/[a-z]+[0-9]+$" match="regex" {
                connectors {
                    "127.0.0.1:9006"
                }
            }

            // The catch-all is always tried last.
            route "/" {
                connectors {
                    "127.0.0.1:9007"
                }
            }
        }
    }

    // Address-based access control, with River behind a load balancer.
    Access {
        listeners {
            "0.0.0.0:8085"
        }
        connectors {
            "127.0.0.1:9000"
        }
        // Without this, every request would be attributed to the load
        // balancer, and the filters below would either block everything or
        // block nothing.
        client-ip {
            trusted-proxies "10.0.0.0/8, 192.168.0.0/16"
        }
        path-control {
            request-filters {
                // Order is what decides the outcome: the deny runs first, so
                // an address in 10.6.6.0/24 is turned away even though the
                // allow list below would have taken it.
                filter kind="block-cidr-range" addrs="10.6.6.0/24"
                filter kind="allow-cidr-range" addrs="10.0.0.0/8, 192.168.0.0/16" \
                    status=403 body="Not permitted from your network\n"
            }
            upstream-request {
                // Both ways of matching a header name, plus the exact form.
                filter kind="remove-header-key-regex" pattern="^x-regex-"
                filter kind="remove-header-key-glob" pattern="x-internal-*"
                filter kind="remove-header" key="x-debug-token"
                filter kind="upsert-header" key="x-proxy-friend" value="river"
            }
            response-filters {
                // Appending rather than replacing, because Vary is a list and
                // an upstream server may already have written to it.
                filter kind="append-header" key="vary" value="accept-encoding"
            }
        }
    }
}
